# PostgreSQL connection string (e.g. a free-tier Neon instance)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Shared secret required to call POST /api/admin/reset-demo
ADMIN_RESET_TOKEN=change-me

# Deepgram — multilingual voice transcription for the Ask AI mic and Start Visit
# recording. Without a key, voice input is disabled with a "not configured" message.
DEEPGRAM_API_KEY=
# nova-3 = multilingual + code-switching. Use nova-3-medical for English-only visits.
DEEPGRAM_MODEL=nova-3
