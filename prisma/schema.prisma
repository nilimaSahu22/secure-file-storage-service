generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DOCTOR
  NURSE
  ADMIN
}

enum AppointmentStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum PriorAuthStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DENIED
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  COMPLETED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ChatActorType {
  DOCTOR
  PATIENT
}

enum VisitStatus {
  DRAFT
  SIGNED
}

enum MedicationStatus {
  ACTIVE
  STOPPED
  COMPLETED
}

enum FileStatus {
  PENDING
  ACCEPTED
  BOUNCED
  NEEDS_CLEARER_COPY
}

enum FileSource {
  STAFF
  PATIENT
}

enum FollowUpKind {
  TEST
  IMAGING
  APPOINTMENT
  REFERRAL
  RESULT_AVAILABLE
  OTHER
}

enum FollowUpStatus {
  OUTSTANDING
  COMPLETED
  DISMISSED
}

enum TrendDirection {
  RISING
  FALLING
  FLUCTUATING
}

enum TrendFlagStatus {
  ACTIVE
  DISMISSED
}

enum Department {
  RADIOLOGY
  OPD
  CARDIOLOGY
  EMERGENCY
}

enum DocumentRequestStatus {
  PENDING
  FULFILLED
  CANCELLED
}

model AssistantThread {
  id               String             @id @default(uuid())
  ownerType        String
  ownerId          String
  title            String             @default("New conversation")
  focusedPatientId String?
  archived         Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  messages         AssistantMessage[]

  @@index([ownerType, ownerId, archived])
}

model AssistantMessage {
  id           String          @id @default(uuid())
  threadId     String
  thread       AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role         String
  content      String          @db.Text
  citedFileIds String[]        @default([])
  actions      Json?
  createdAt    DateTime        @default(now())

  @@index([threadId])
}

model DocumentRequest {
  id                String                @id @default(uuid())
  patientId         String
  patient           Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestedById     String
  requestedBy       StaffUser             @relation(fields: [requestedById], references: [id])
  documentType      String
  description       String
  dueAt             DateTime?
  status            DocumentRequestStatus @default(PENDING)
  fulfilledByFileId String?
  createdAt         DateTime              @default(now())

  @@index([patientId, status])
}

model StaffUser {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role
  department   Department?

  notes                 ClinicalNote[]
  appointments          Appointment[]
  tasksAssigned         Task[]
  referralsFrom         Referral[]        @relation("ReferralFrom")
  referralsTo           Referral[]        @relation("ReferralTo")
  uploadedFiles         MedicalFile[]
  chatMessages          ChatMessage[]
  visitsAuthored        Visit[]           @relation("VisitAuthor")
  visitsSigned          Visit[]           @relation("VisitSigner")
  prescribedMedications Medication[]      @relation("MedicationPrescriber")
  documentRequests      DocumentRequest[]
}

model Patient {
  id                 String   @id @default(uuid())
  firstName          String
  lastName           String
  dateOfBirth        DateTime
  gender             String
  contactPhone       String?
  contactEmail       String?
  portalEmail        String?  @unique
  portalPasswordHash String?
  createdAt          DateTime @default(now())

  medications      Medication[]
  allergies        Allergy[]
  vitals           VitalSign[]
  testResults      TestResult[]
  notes            ClinicalNote[]
  appointments     Appointment[]
  visits           Visit[]
  prescriptions    Prescription[]
  visitSummaries   PatientVisitSummary[]
  followUpItems    FollowUpItem[]
  trendFlags       TrendFlag[]
  tasks            Task[]
  priorAuths       PriorAuthorization[]
  referrals        Referral[]
  chartSummaries   ChartSummary[]
  alerts           ClinicalAlert[]
  files            MedicalFile[]
  chatMessages     ChatMessage[]
  documentRequests DocumentRequest[]
}

model Medication {
  id             String           @id @default(uuid())
  patientId      String
  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name           String
  dosage         String
  frequency      String
  route          String?
  duration       String?
  status         MedicationStatus @default(ACTIVE)
  visitId        String?
  visit          Visit?           @relation(fields: [visitId], references: [id])
  prescribedById String?
  prescribedBy   StaffUser?       @relation("MedicationPrescriber", fields: [prescribedById], references: [id])
  prescribedAt   DateTime         @default(now())

  @@index([patientId])
}

model Allergy {
  id        String        @id @default(uuid())
  patientId String
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergen  String
  reaction  String?
  severity  AlertSeverity @default(MEDIUM)

  @@index([patientId])
}

model VitalSign {
  id         String   @id @default(uuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId    String?
  visit      Visit?   @relation(fields: [visitId], references: [id])
  type       String
  value      String
  isAbnormal Boolean  @default(false)
  recordedAt DateTime @default(now())

  @@index([patientId])
}

model TestResult {
  id           String       @id @default(uuid())
  patientId    String
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  testName     String
  result       String
  normalRange  String?
  recordedAt   DateTime     @default(now())
  documentDate DateTime?
  enteredByAI  Boolean      @default(false)
  sourceFileId String?
  sourceFile   MedicalFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  @@index([patientId])
}

model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId  String
  provider    StaffUser         @relation(fields: [providerId], references: [id])
  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)
  reason      String?

  @@index([patientId])
  @@index([providerId])
}

model Visit {
  id                 String      @id @default(uuid())
  patientId          String
  patient            Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId           String?
  author             StaffUser?  @relation("VisitAuthor", fields: [authorId], references: [id])
  transcript         String?     @db.Text
  status             VisitStatus @default(DRAFT)
  signedAt           DateTime?
  signedById         String?
  signedBy           StaffUser?  @relation("VisitSigner", fields: [signedById], references: [id])
  signatureStatement String?
  prescriptionPdfKey String?
  startedAt          DateTime    @default(now())

  vitals         VitalSign[]
  note           ClinicalNote?
  prescription   Prescription?
  patientSummary PatientVisitSummary?
  followUpItems  FollowUpItem[]
  medications    Medication[]

  @@index([patientId])
}

model ClinicalNote {
  id            String    @id @default(uuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId      String
  author        StaffUser @relation(fields: [authorId], references: [id])
  visitId       String?   @unique
  visit         Visit?    @relation(fields: [visitId], references: [id])
  subjective    String
  objective     String
  assessment    String
  plan          String
  isAiGenerated Boolean   @default(false)
  noteVersion   Int       @default(1)
  createdAt     DateTime  @default(now())

  codingSuggestions CodingSuggestion[]
  tasks             Task[]

  @@index([patientId])
}

model Prescription {
  id             String    @id @default(uuid())
  visitId        String    @unique
  visit          Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  investigations String[]  @default([])
  advice         String?   @db.Text
  followUpAt     DateTime?
  finalizedAt    DateTime?
  createdAt      DateTime  @default(now())

  items PrescriptionItem[]

  @@index([patientId])
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationName String
  dose           String
  route          String
  frequency      String
  duration       String?
  instructions   String?      @db.Text
  sortOrder      Int          @default(0)
  medicationId   String?
  createdAt      DateTime     @default(now())

  @@index([prescriptionId])
}

model TrendFlag {
  id                   String          @id @default(uuid())
  patientId            String
  patient              Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  metric               String
  direction            TrendDirection
  severity             AlertSeverity   @default(LOW)
  window               String
  dataPoints           Json
  deterministicSummary String
  narrative            String?         @db.Text
  status               TrendFlagStatus @default(ACTIVE)
  computedAt           DateTime        @default(now())

  @@unique([patientId, metric, direction])
  @@index([patientId, status])
}

model FollowUpItem {
  id                      String         @id @default(uuid())
  patientId               String
  patient                 Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId                 String?
  visit                   Visit?         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  kind                    FollowUpKind
  description             String
  dueAt                   DateTime?
  status                  FollowUpStatus @default(OUTSTANDING)
  satisfiedByFileId       String?
  satisfiedByTestResultId String?
  createdAt               DateTime       @default(now())

  @@index([patientId, status])
}

model PatientVisitSummary {
  id                String   @id @default(uuid())
  visitId           String   @unique
  visit             Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  plainSummary      String   @db.Text
  plainPrescription String   @db.Text
  sourceNoteVersion Int
  stale             Boolean  @default(false)
  generatedAt       DateTime @default(now())

  @@index([patientId])
}

model CodingSuggestion {
  id          String       @id @default(uuid())
  noteId      String
  note        ClinicalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  code        String
  codeSystem  String
  description String
  rationale   String
  createdAt   DateTime     @default(now())

  @@index([noteId])
}

model Task {
  id              String        @id @default(uuid())
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  noteId          String?
  note            ClinicalNote? @relation(fields: [noteId], references: [id])
  assignedToId    String?
  assignedTo      StaffUser?    @relation(fields: [assignedToId], references: [id])
  description     String
  status          TaskStatus    @default(PENDING)
  isAutoGenerated Boolean       @default(true)
  createdAt       DateTime      @default(now())

  @@index([patientId])
}

model PriorAuthorization {
  id                 String          @id @default(uuid())
  patientId          String
  patient            Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  serviceDescription String
  status             PriorAuthStatus @default(SUBMITTED)
  submittedAt        DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([patientId])
}

model Referral {
  id             String         @id @default(uuid())
  patientId      String
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fromProviderId String
  fromProvider   StaffUser      @relation("ReferralFrom", fields: [fromProviderId], references: [id])
  toProviderId   String
  toProvider     StaffUser      @relation("ReferralTo", fields: [toProviderId], references: [id])
  reason         String
  status         ReferralStatus @default(PENDING)
  createdAt      DateTime       @default(now())

  @@index([patientId])
}

model ChartSummary {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  summary     String
  generatedAt DateTime @default(now())

  @@index([patientId])
}

model ClinicalAlert {
  id          String        @id @default(uuid())
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type        String
  message     String
  severity    AlertSeverity @default(MEDIUM)
  triggeredAt DateTime      @default(now())

  @@index([patientId])
}

model MedicalFile {
  id                String      @id @default(uuid())
  patientId         String
  patient           Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedByStaffId String?
  uploadedByStaff   StaffUser?  @relation(fields: [uploadedByStaffId], references: [id])
  uploadedByPatient Boolean     @default(false)
  fileName          String
  storageKey        String      @unique
  mimeType          String
  sizeBytes         Int
  category          String
  department        Department?
  version           Int         @default(1)
  previousVersionId String?
  extractedText     String?     @db.Text
  status            FileStatus  @default(ACCEPTED)
  source            FileSource  @default(STAFF)
  contentHash       String?
  documentDate      DateTime?
  validation        Json?
  bounceReason      String?
  createdAt         DateTime    @default(now())

  testResults TestResult[]

  @@index([patientId])
  @@index([patientId, contentHash])
}

model ChatMessage {
  id           String        @id @default(uuid())
  patientId    String
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  actorType    ChatActorType
  staffId      String?
  staff        StaffUser?    @relation(fields: [staffId], references: [id])
  role         String
  content      String        @db.Text
  citedFileIds String[]      @default([])
  createdAt    DateTime      @default(now())

  @@index([patientId, actorType])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorType  String
  actorId    String?
  actorName  String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

model DepartmentWorkflow {
  id             String     @id @default(uuid())
  department     Department @unique
  intakeSteps    Json
  triageRules    Json
  escalationPath Json
  updatedAt      DateTime   @updatedAt
}

model Inquiry {
  id                  String   @id @default(uuid())
  fullName            String
  workEmail           String
  organizationName    String
  role                String
  patientVolumePerDay String?
  problemStatement    String   @db.Text
  phone               String?
  consentGiven        Boolean
  createdAt           DateTime @default(now())
}
